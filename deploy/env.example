# Plantilla de /etc/fsconstrucciones.env (setup.sh la genera y reemplaza los __PLACEHOLDERS__).
# El archivo real queda con permisos 640 root:fsapp. No lo subas a git.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=__SECRET_KEY__
DJANGO_ADMIN_URL=__ADMIN_URL__
DJANGO_ALLOWED_HOSTS=__DOMAIN__,www.__DOMAIN__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__DOMAIN__,https://www.__DOMAIN__

# nginx es el unico proxy delante de gunicorn: toma la IP real del cliente del
# ultimo valor de X-Forwarded-For (el que escribe nginx), no del que manda el cliente.
DJANGO_TRUSTED_PROXY_HOPS=1

# Fotos subidas desde el panel: fuera del checkout de git para que un deploy no las toque.
DJANGO_MEDIA_ROOT=/srv/fsconstrucciones/media

# PostgreSQL local por socket unix: autenticacion "peer" (el usuario del sistema
# fsapp entra como rol fsapp), asi que no hay contrasena de base de datos.
DB_HOST=/var/run/postgresql
DB_NAME=fsconstrucciones
DB_USER=fsapp

# HSTS: dejar en 0 hasta confirmar que HTTPS funciona en dominio y www; despues subir
# de a poco (300 -> 86400 -> 31536000).
DJANGO_HSTS_SECONDS=0
