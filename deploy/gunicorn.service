[Unit]
Description=FS Construcciones (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=fsapp
Group=www-data
RuntimeDirectory=fsconstrucciones
RuntimeDirectoryMode=0755
WorkingDirectory=/srv/fsconstrucciones/app
EnvironmentFile=/etc/fsconstrucciones.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/fsconstrucciones/venv/bin/gunicorn core.wsgi:application \
    --bind unix:/run/fsconstrucciones/gunicorn.sock --umask 007 \
    --workers 3 --timeout 60 --access-logfile - --error-logfile -
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/srv/fsconstrucciones/media

[Install]
WantedBy=multi-user.target
